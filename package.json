{
  "name": "motion-kit",
  "version": "0.6.0",
  "description": "Librería propia de efectos y animaciones para React",
  "license": "MIT",
  "type": "module",
  "main": "./dist/motion-kit.cjs",
  "module": "./dist/motion-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/motion-kit.js",
      "require": "./dist/motion-kit.cjs"
    },
    "./encabezado": {
      "types": "./dist/entradas/encabezado.d.ts",
      "import": "./dist/encabezado.js",
      "require": "./dist/encabezado.cjs"
    },
    "./escena": {
      "types": "./dist/entradas/escena.d.ts",
      "import": "./dist/escena.js",
      "require": "./dist/escena.cjs"
    },
    "./pagina": {
      "types": "./dist/entradas/pagina.d.ts",
      "import": "./dist/pagina.js",
      "require": "./dist/pagina.cjs"
    },
    "./momentos": {
      "types": "./dist/entradas/momentos.d.ts",
      "import": "./dist/momentos.js",
      "require": "./dist/momentos.cjs"
    },
    "./director": {
      "types": "./dist/entradas/director.d.ts",
      "import": "./dist/director.js",
      "require": "./dist/director.cjs"
    },
    "./partitura": {
      "types": "./dist/entradas/partitura.d.ts",
      "import": "./dist/partitura.js",
      "require": "./dist/partitura.cjs"
    },
    "./luz": {
      "types": "./dist/entradas/luz.d.ts",
      "import": "./dist/luz.js",
      "require": "./dist/luz.cjs"
    },
    "./interfaz": {
      "types": "./dist/entradas/interfaz.d.ts",
      "import": "./dist/interfaz.js",
      "require": "./dist/interfaz.cjs"
    },
    "./comic": {
      "types": "./dist/entradas/comic.d.ts",
      "import": "./dist/comic.js",
      "require": "./dist/comic.cjs"
    },
    "./receta": {
      "types": "./dist/receta/index.d.ts",
      "import": "./dist/receta.js",
      "require": "./dist/receta.cjs"
    },
    "./estilos.css": "./dist/estilos.css",
    "./estilos-encabezado.css": "./dist/estilos-encabezado.css",
    "./estilos-pagina.css": "./dist/estilos-pagina.css",
    "./estilos-momentos.css": "./dist/estilos-momentos.css",
    "./estilos-luz.css": "./dist/estilos-luz.css",
    "./contrato/encabezado-motionkit.json": "./contrato/encabezado-motionkit.json",
    "./contrato/pagina-motionkit.json": "./contrato/pagina-motionkit.json",
    "./contrato/partitura-motionkit.json": "./contrato/partitura-motionkit.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contrato"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tabla": "node scripts/revisar-tabla-nombres.mjs",
    "dev": "vite",
    "demo:armar": "vite build --mode demo",
    "demo:servir": "vite preview --mode demo --port 4173 --strictPort",
    "dev:red": "vite --host",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/generar-css.mjs && node scripts/medir-paquete.mjs",
    "prepare": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generar-contrato.mjs --revisar && node scripts/pruebas.mjs",
    "contrato": "node scripts/generar-contrato.mjs",
    "peso": "node scripts/medir-paquete.mjs --revisar",
    "verificar": "node scripts/verificar-cambios.mjs",
    "humo": "node scripts/humo.mjs",
    "probar-paquete": "node scripts/probar-paquete.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
